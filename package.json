{
	"name": "image-optimise-sharp",
	"version": "1.0.0",
	"description": "High-performance image optimization tool with functional programming approach",
	"main": "index.mjs",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/sahillangoo/image-optimise-sharp.git"
	},
	"scripts": {
		"compress": "bun index.mjs",
		"compress:ai": "bun index.mjs --ai",
		"compress:fast": "bun index.mjs --fast",
		"compress:extreme": "bun index.mjs --extreme",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"keywords": ["image", "optimization", "compression", "sharp", "webp", "avif"],
	"author": "@sahillangoo",
	"license": "ISC",
	"dependencies": {
		"chalk": "^5.6.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4"
	}
}
