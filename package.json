{
  "name": "image-optimise-sharp",
  "version": "1.0.0",
  "description": "High-performance image optimization tool with functional programming approach",
  "main": "index.mjs",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/sahillangoo/image-optimise-sharp.git"
  },
  "scripts": {
    "compress": "node --max-old-space-size=4096 --expose-gc index.mjs",
    "compress:fast": "node --max-old-space-size=4096 --expose-gc index.mjs -- --fast",
    "compress:extreme": "node --max-old-space-size=4096 --expose-gc index.mjs -- --extreme",
    "clean": "node scripts/clean-cache.mjs",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "image",
    "optimization",
    "compression",
    "sharp",
    "webp",
    "avif"
  ],
  "author": "@sahillangoo",
  "license": "ISC",
  "dependencies": {
    "chalk": "^5.6.2",
    "sharp": "^0.34.5"
  }
}
