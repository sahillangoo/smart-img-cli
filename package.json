{
	"name": "smart-img-cli",
	"version": "1.0.0",
	"description": "Lightning-fast image compression and local AI-powered SEO renaming, built on Bun and LM Studio.",
	"main": "index.mjs",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/sahillangoo/smart-img-cli.git"
	},
	"scripts": {
		"compress": "bun index.mjs --compress",
		"rename": "bun index.mjs --rename",
		"rename:force": "bun index.mjs --rename --force-rename",
		"all": "bun index.mjs --all",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"keywords": ["image", "optimization", "compression", "sharp", "webp", "avif"],
	"author": "@sahillangoo",
	"license": "MIT",
	"dependencies": {
		"chalk": "^5.6.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4"
	}
}
